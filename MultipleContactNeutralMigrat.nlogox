    <button x="20" y="645" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="172">Block-deforestation</button>
    <slider x="20" step="1" y="739" max="200" width="202" display="habitat-patch-size" height="50" min="1" direction="Horizontal" default="3.0" variable="habitat-patch-size"></slider>
    <button x="20" y="692" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="182">regular-deforestation</button>
    <monitor x="15" precision="5" y="801" height="60" fontSize="11" width="217" display="Efective degraded proportion">efective-degraded-proportion</monitor>
    <slider x="250" step="100" y="632" max="600" width="207" display="Deforestation-at-time" height="50" min="0" direction="Horizontal" default="600.0" variable="Deforestation-at-time"></slider>
